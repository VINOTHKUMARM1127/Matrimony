# Supabase
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Razorpay (public key ID only — secret lives server-side, see bug #2 fix)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# App
EXPO_PUBLIC_APP_ENV=development

# Cloudflare R2 Storage (Public URL only)
EXPO_PUBLIC_R2_BUCKET_NAME=
EXPO_PUBLIC_R2_PUBLIC_URL=

# Server-only secrets — set these with `eas secret:create` or `supabase secrets set`,
# never put them in this file with an EXPO_PUBLIC_ prefix:
# SUPABASE_SERVICE_ROLE_KEY=
# RAZORPAY_KEY_SECRET=
